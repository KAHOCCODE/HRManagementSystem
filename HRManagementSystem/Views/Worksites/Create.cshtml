@model HR_KD.Data.Worksite
@using HR_KD.Services
@{
    Layout = "~/Views/Shared/_ThemeLayout.cshtml";
    ViewData["Title"] = "Thêm chi nhánh";
}
<div class="container-fluid">
    <h1>Thêm chi nhánh</h1>
    <form asp-action="Create" method="post">
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <div class="form-group">
            <label asp-for="Code"></label>
            <input asp-for="Code" class="form-control" required />
        </div>
        <div class="form-group">
            <label asp-for="Name"></label>
            <input asp-for="Name" class="form-control" required />
        </div>
        <div class="form-group">
            <label asp-for="Province"></label>
            <input asp-for="Province" class="form-control" required />
        </div>
        <div class="form-group">
            <label asp-for="Ward"></label>
            <input asp-for="Ward" class="form-control" list="hcm-wards" required />
            <datalist id="hcm-wards">
                @foreach (var area in HcmWageAreas.All)
                {
                    <option value="@area.Name"></option>
                }
            </datalist>
            <small>Với TP.HCM, chọn tên trong danh sách. Mỗi chi nhánh dùng địa chỉ nơi làm việc.</small>
        </div>
        <div class="form-group">
            <label asp-for="Address"></label>
            <input asp-for="Address" class="form-control" required />
        </div>
        <fieldset class="mb-3">
            <legend class="h5">Vùng lương cần nhập thủ công</legend>
            <p>Web tự điền vùng cho TP.HCM theo phụ lục. Với địa điểm ngoài TP.HCM, nhập vùng đã đối chiếu cho từng năm. Với phường Tây Thạnh, cần xác minh riêng năm 2026 trước khi nhập.</p>
            <div class="form-row">
                <div class="form-group col-sm-6">
                    <label asp-for="Region2026"></label>
                    <input asp-for="Region2026" class="form-control" min="1" max="4" />
                </div>
                <div class="form-group col-sm-6">
                    <label asp-for="Region2027"></label>
                    <input asp-for="Region2027" class="form-control" min="1" max="4" />
                </div>
            </div>
        </fieldset>
        <button type="submit" class="btn btn-primary">Lưu chi nhánh</button>
        <a asp-action="Index">Về danh sách</a>
    </form>
</div>
