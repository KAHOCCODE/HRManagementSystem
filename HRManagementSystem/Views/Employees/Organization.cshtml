@model HR_KD.Models.OrganizationChartPage
@{
    Layout = "~/Views/Shared/_ThemeLayout.cshtml";
    ViewData["Title"] = "Sơ đồ tổ chức";
}

@section Styles {
    <link rel="stylesheet" href="~/css/organization.css" asp-append-version="true" />
}

<div class="container-fluid py-4">
    <section class="card shadow border-0">
        <header class="card-header bg-primary text-white staff-card-header">
            <h1 class="h4 mb-0">Sơ đồ tổ chức</h1>
            @if (User.IsInRole("DIRECTOR") || User.IsInRole("EMPLOYEE_MANAGER"))
            {
                <a asp-action="Index" class="btn btn-light btn-sm"><i class="fa fa-arrow-left" aria-hidden="true"></i> Quản lý nhân viên</a>
            }
        </header>
        <div class="card-body">
            <h2 class="h5 mb-1">@Model.Name</h2>
            <p class="text-muted">@Model.EmployeeCount nhân viên</p>
            @if (Model.Roots.Count == 0)
            {
                <p class="text-muted mb-0">Chưa có hồ sơ nhân viên.</p>
            }
            else
            {
                <div class="organization-toolbar">
                    <div class="form-group organization-search mb-0">
                        <label for="organization-search">Tìm nhân viên, chức vụ hoặc phòng ban</label>
                        <input id="organization-search" class="form-control" type="search">
                    </div>
                    <div class="form-group organization-worksites mb-0">
                        <label for="organization-worksite">Chi nhánh / nơi làm việc</label>
                        <select id="organization-worksite" class="form-control">
                            <option value="">Tất cả nơi làm việc</option>
                            @foreach (var site in Model.Worksites)
                            {
                                <option value="@site.Id" selected="@(Model.SelectedWorksiteId == site.Id)">@site.Name</option>
                            }
                            <option value="unassigned">Chưa gán nơi làm việc</option>
                        </select>
                    </div>
                    <div class="btn-group" role="group" aria-label="Điều chỉnh sơ đồ">
                        <button id="organization-zoom-out" class="btn btn-outline-primary btn-sm" type="button" aria-label="Thu nhỏ"><i class="fa fa-minus" aria-hidden="true"></i></button>
                        <output id="organization-zoom" class="organization-scale">100%</output>
                        <button id="organization-zoom-in" class="btn btn-outline-primary btn-sm" type="button" aria-label="Phóng to"><i class="fa fa-plus" aria-hidden="true"></i></button>
                        <button id="organization-fit" class="btn btn-outline-primary btn-sm" type="button">Vừa khung</button>
                    </div>
                </div>
                <p id="organization-filter-status" class="text-muted mb-2" hidden role="status"></p>
                <p id="organization-empty" class="text-muted mt-3" hidden role="status">Không tìm thấy nhân viên phù hợp.</p>
                <div id="organization-viewport" class="organization-viewport" tabindex="0" role="region" aria-label="Sơ đồ phân cấp nhân viên">
                    <ul id="organization-tree" class="organization-forest" aria-label="Cấp quản lý cao nhất">
                        @foreach (var root in Model.Roots)
                        {
                            <partial name="_OrganizationMember" model="root" />
                        }
                    </ul>
                </div>
            }
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/organization.js" asp-append-version="true"></script>
}
