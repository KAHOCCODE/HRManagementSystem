@model HR_KD.Data.Worksite
@{
    Layout = "~/Views/Shared/_ThemeLayout.cshtml";
    ViewData["Title"] = "Chỉnh thông tin chi nhánh";
}
<div class="container-fluid">
    <h1>Chỉnh thông tin chi nhánh</h1>
    <p>@Model.Code · @Model.Ward, @Model.Province. Khi chuyển sang xã hoặc phường khác, tạo địa điểm mới và gán ngày bắt đầu để giữ lịch sử.</p>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <div class="form-group">
            <label asp-for="Name"></label>
            <input asp-for="Name" class="form-control" required />
        </div>
        <div class="form-group">
            <label asp-for="Address"></label>
            <input asp-for="Address" class="form-control" required />
        </div>
        @if (!Model.Region2026.HasValue)
        {
            <div class="form-group">
                <label for="confirmedRegion2026">Vùng lương năm 2026 đã xác minh</label>
                <input id="confirmedRegion2026" name="confirmedRegion2026" type="number" min="1" max="4" class="form-control" />
            </div>
        }
        <button type="submit" class="btn btn-primary">Lưu thông tin</button>
        <a asp-action="Index">Về danh sách</a>
    </form>
</div>
