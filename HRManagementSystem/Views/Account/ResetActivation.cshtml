@{
    Layout = "~/Views/Shared/_ThemeLayout.cshtml";
    ViewData["Title"] = "Cấp lại mật khẩu tạm";
}
<h1>Cấp lại mật khẩu tạm</h1>
<p>Hệ thống gửi mật khẩu tạm đến email trong hồ sơ nhân viên và thu hồi các phiên đăng nhập cũ.</p>
@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}
<form asp-action="ResetActivation" method="post">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <div class="form-group">
        <label for="username">Tên đăng nhập của nhân viên</label>
        <input class="form-control" id="username" name="username" required />
    </div>
    <button class="btn btn-primary" type="submit">Gửi mật khẩu tạm</button>
</form>
