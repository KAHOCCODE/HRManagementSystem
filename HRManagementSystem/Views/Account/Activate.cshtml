@model string
@{
    ViewData["Title"] = "Đặt mật khẩu";
}
<h1>Đặt mật khẩu</h1>
<p>Dùng mật khẩu tạm trong thư kích hoạt. Mật khẩu tạm hết hạn sau 24 giờ.</p>
<form asp-action="Activate" method="post">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <input type="hidden" name="ticket" value="@Model" />
    <div class="form-group">
        <label for="temporaryPassword">Mật khẩu tạm</label>
        <input class="form-control" type="password" id="temporaryPassword" name="temporaryPassword" autocomplete="current-password" required />
    </div>
    <div class="form-group">
        <label for="newPassword">Mật khẩu mới</label>
        <input class="form-control" type="password" id="newPassword" name="newPassword" autocomplete="new-password" minlength="12" required />
        <small>Ít nhất 12 ký tự, tối đa 56 byte.</small>
    </div>
    <button class="btn btn-primary" type="submit">Lưu mật khẩu</button>
    <a asp-action="Login">Về trang đăng nhập</a>
</form>
