@using HR_KD.Data
@{
    Layout = "~/Views/Shared/_ThemeLayout.cshtml";
    ViewData["Title"] = "Gán chi nhánh cho nhân viên";
    var employees = (IReadOnlyList<KeyValuePair<int, string>>)ViewBag.Employees;
    var sites = (IReadOnlyList<Worksite>)ViewBag.Worksites;
    var history = (IReadOnlyList<WorksiteAssignment>)ViewBag.History;
    int? selectedEmployee = ViewBag.EmployeeId;
    int? selectedWorksite = ViewBag.SelectedWorksiteId;
    var today = DateOnly.FromDateTime(DateTime.UtcNow.AddHours(7));
    var currentAssignment = history.FirstOrDefault(x => x.EffectiveFrom <= today);
}
<div class="container-fluid">
    <h1>Gán chi nhánh cho nhân viên</h1>
    @if (TempData["WorksiteAssignmentSaved"] is string notice)
    {
        <p class="alert alert-success" role="status">@notice</p>
    }
    @if (sites.Count == 0)
    {
        <p><a asp-action="Create">Thêm chi nhánh</a> để gán nơi làm việc cho nhân viên.</p>
    }
    else
    {
        <form asp-action="Assign" method="post">
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            <div class="form-group">
                <label for="employeeId">Nhân viên</label>
                <select id="employeeId" name="employeeId" class="form-control" required>
                    <option value="">Chọn nhân viên</option>
                    @foreach (var employee in employees)
                    {
                        <option value="@employee.Key" selected="@(selectedEmployee == employee.Key)">@employee.Value (#@employee.Key)</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label for="worksiteId">Chi nhánh</label>
                <select id="worksiteId" name="worksiteId" class="form-control" required>
                    <option value="">Chọn chi nhánh</option>
                    @foreach (var site in sites)
                    {
                        <option value="@site.Id" selected="@(selectedWorksite == site.Id)">@site.Code · @site.Name</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label for="effectiveFrom">Ngày bắt đầu tại chi nhánh</label>
                <input type="date" id="effectiveFrom" name="effectiveFrom" value="@ViewBag.EffectiveFrom" class="form-control" required />
            </div>
            <button type="submit" class="btn btn-primary">Lưu nơi làm việc</button>
        </form>
    }
    <h2 class="h4 mt-4">Lịch sử nơi làm việc</h2>
    <form asp-action="Assign" method="get" class="mb-3">
        <label for="historyEmployee">Chọn nhân viên để xem lịch sử</label>
        <select id="historyEmployee" name="employeeId" class="form-control" required>
            <option value="">Chọn nhân viên</option>
            @foreach (var employee in employees)
            {
                <option value="@employee.Key" selected="@(selectedEmployee == employee.Key)">@employee.Value (#@employee.Key)</option>
            }
        </select>
        <button class="btn btn-outline-primary mt-2" type="submit">Xem lịch sử</button>
    </form>
    @if (selectedEmployee.HasValue && history.Count == 0)
    {
        <p>Nhân viên chưa có nơi làm việc được gán.</p>
    }
    @if (history.Count > 0)
    {
        <div class="table-responsive">
        <table class="table table-striped">
            <thead><tr><th scope="col">Từ ngày</th><th scope="col">Chi nhánh</th><th scope="col">Hiệu lực</th></tr></thead>
            <tbody>
            @foreach (var assignment in history)
            {
                <tr>
                    <td>@assignment.EffectiveFrom.ToString("dd/MM/yyyy")</td>
                    <td>@assignment.Worksite.Code · @assignment.Worksite.Name</td>
                    <td>@(assignment.Id == currentAssignment?.Id ? "Đang áp dụng" : assignment.EffectiveFrom > today ? "Sắp áp dụng" : "Đã kết thúc")</td>
                </tr>
            }
            </tbody>
        </table>
        </div>
    }
    <a asp-action="Index">Về danh sách chi nhánh</a>
</div>
