@model List<HR_KD.DTOs.ImportNhanVienDto>
@{
    Layout = "~/Views/Shared/_ThemeLayout.cshtml";
    ViewData["Title"] = "Xem trước dữ liệu nhập nhân viên";
    var chucVuMap = (Dictionary<int, string>)ViewBag.ChucVus ?? new();
    var phongBanMap = (Dictionary<int, string>)ViewBag.PhongBans ?? new();
    var worksiteMap = (Dictionary<int, string>)ViewBag.Worksites ?? new();
    var managerMap = (Dictionary<int, string>)ViewBag.Managers ?? new();
}

<style>
    input.form-control, select.form-control {
        min-width: 160px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>
<h2 class="text-primary mt-4 mb-3"><i class="fa fa-file-excel-o"></i> Xem trước dữ liệu nhân viên</h2>

@if (TempData["ImportSummary"] is string summary)
{
    <div class="alert alert-info" role="status">@summary</div>
}

<form id="saveAllForm" method="post" action="/api/EmployeesApi/SaveImportBatch" novalidate>
    @Html.AntiForgeryToken()
    <div class="table-responsive">
        <table class="table table-bordered table-hover shadow align-middle text-center" id="importTable">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Họ Tên</th>
                    <th>Ngày Sinh</th>
                    <th>Giới Tính</th>
                    <th>SĐT</th>
                    <th>Email</th>
                    <th>Trình Độ</th>
                    <th>Chức Vụ</th>
                    <th>Phòng Ban</th>
                    <th>Ngày Vào Làm</th>
                    <th>Chi nhánh</th>
                    <th>Quản lý trực tiếp</th>
                    <th>Ghi chú lỗi</th>
                    <th>Xóa</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Count; i++)
                {
                    var emp = Model[i];
                    bool hasError = !string.IsNullOrWhiteSpace(emp.RowError);
                    string rowClass = hasError ? "table-danger" : "";

                    <tr class="@rowClass">
                        <td>
                            <input type="hidden" name="list.Index" value="@i" />
                            <input type="hidden" name="list[@i].RowIndex" value="@emp.RowIndex" />
                            <span class="import-row-number">@(emp.RowIndex > 0 ? emp.RowIndex.ToString() : "Mới")</span>
                            @if (hasError)
                            {
                                <i class="fa fa-exclamation-circle text-danger" title="@emp.RowError"></i>
                            }
                            else
                            {
                                <i class="fa fa-check-circle text-success" title="Hợp lệ"></i>
                            }
                        </td>
                        <td><input type="text" class="form-control" name="list[@i].HoTen" value="@emp.HoTen" /></td>
                        <td><input type="date" class="form-control" name="list[@i].NgaySinh" value="@(emp.NgaySinh == default ? "" : emp.NgaySinh.ToString("yyyy-MM-dd"))" /></td>
                        <td>
                            <select class="form-control" name="list[@i].GioiTinh">
                                <option value="true" selected="@emp.GioiTinh">Nam</option>
                                <option value="false" selected="@(!emp.GioiTinh)">Nữ</option>
                            </select>
                        </td>
                        <td><input type="text" class="form-control" name="list[@i].Sdt" value="@emp.Sdt" /></td>
                        <td><input type="email" class="form-control" name="list[@i].Email" value="@emp.Email" /></td>
                        <td><input type="text" class="form-control" name="list[@i].TrinhDoHocVan" value="@emp.TrinhDoHocVan" /></td>
                        <td>
                            <select class="form-control" name="list[@i].MaChucVu">
                                <option value="">Chọn chức vụ</option>
                                @foreach (var position in chucVuMap)
                                {
                                    <option value="@position.Key" selected="@(position.Key == emp.MaChucVu)">@position.Value</option>
                                }
                            </select>
                        </td>
                        <td>
                            <select class="form-control" name="list[@i].MaPhongBan">
                                <option value="">Chọn phòng ban</option>
                                @foreach (var department in phongBanMap)
                                {
                                    <option value="@department.Key" selected="@(department.Key == emp.MaPhongBan)">@department.Value</option>
                                }
                            </select>
                        </td>
                        <td><input type="date" class="form-control" name="list[@i].NgayVaoLam" value="@(emp.NgayVaoLam == default ? "" : emp.NgayVaoLam.ToString("yyyy-MM-dd"))" /></td>
                        <td>
                            <select class="form-control" name="list[@i].WorksiteId">
                                <option value="">Chưa gán</option>
                                @foreach (var site in worksiteMap)
                                {
                                    <option value="@site.Key" selected="@(site.Key == emp.WorksiteId)">@site.Value</option>
                                }
                            </select>
                        </td>
                        <td>
                            <select class="form-control" name="list[@i].ManagerId">
                                <option value="">Chưa gán</option>
                                @foreach (var manager in managerMap)
                                {
                                    <option value="@manager.Key" selected="@(manager.Key == emp.ManagerId)">@manager.Key · @manager.Value</option>
                                }
                            </select>
                        </td>
                        <td class="text-danger small import-row-error">@emp.RowError</td>
                        <td>
                            <button type="button" class="btn btn-outline-danger btn-sm" title="Xóa dòng này"
                                    onclick="$(this).closest('tr').remove();">
                                <i class="fa fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="text-center">
        <button type="button" class="btn btn-outline-primary" onclick="addNewRow()">
            <i class="fa fa-plus"></i> Thêm dòng
        </button>

        <button type="submit" class="btn btn-success px-4 ms-2">
            <i class="fa fa-save"></i> Lưu toàn bộ hợp lệ
        </button>
    </div>
</form>

@section Scripts {
    <script>
        const importBody = document.querySelector("#importTable tbody");
        const importRowTemplate = importBody.firstElementChild?.cloneNode(true);
        let rowIndex = @Model.Count;

        function addNewRow() {
            if (!importRowTemplate) return;

            const row = importRowTemplate.cloneNode(true);
            row.classList.remove("table-danger");
            row.querySelector(".import-row-number").textContent = "Mới";
            row.querySelector(".import-row-number").parentElement.querySelector("i")?.remove();
            row.querySelector(".import-row-error").textContent = "";
            for (const field of row.querySelectorAll("[name]")) {
                if (field.name === "list.Index") {
                    field.value = rowIndex;
                } else {
                    field.name = field.name.replace(/\[\d+\]/, `[${rowIndex}]`);
                    if (field instanceof HTMLSelectElement) {
                        field.selectedIndex = 0;
                    } else {
                        field.value = field.type === "hidden" ? "0" : "";
                    }
                }
            }
            importBody.append(row);
            rowIndex++;
        }
    </script>
}
