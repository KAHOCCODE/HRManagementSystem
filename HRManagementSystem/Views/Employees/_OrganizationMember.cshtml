@model HR_KD.Models.OrganizationMember
@{
    var canManage = User.IsInRole("DIRECTOR") || User.IsInRole("EMPLOYEE_MANAGER");
}
<li class="organization-node" data-organization-label="@($"{Model.Name} {Model.Position} {Model.Department} {Model.Worksite}")" data-employee="@Model.Id" data-manager="@Model.ManagerId">
    <div class="organization-person">
        <img class="organization-photo" src="@HR_KD.Services.EmployeePhotos.DisplayUrl(Model.AvatarUrl)" alt="" loading="lazy" width="52" height="52">
        <div class="organization-person-text">
            @if (canManage)
            {
                <a asp-action="EditProfile" asp-route-id="@Model.Id" class="organization-name">@Model.Name</a>
            }
            else
            {
                <strong class="organization-name">@Model.Name</strong>
            }
            <span>@Model.Position</span>
            <small class="text-muted">@Model.Department@if (Model.Worksite != null) { <text> · @Model.Worksite</text> }</small>
        </div>
    </div>
    @if (Model.Reports.Count > 0)
    {
        <button class="organization-toggle" type="button" aria-expanded="true" aria-controls="organization-reports-@Model.Id" aria-label="Nhân viên dưới quyền @Model.Name">
            <i class="fa fa-chevron-down" aria-hidden="true"></i>
            <span>@Model.Reports.Count cấp dưới</span>
        </button>
        <ul id="organization-reports-@Model.Id" class="organization-children">
            @foreach (var report in Model.Reports)
            {
                <partial name="_OrganizationMember" model="report" />
            }
        </ul>
    }
</li>
